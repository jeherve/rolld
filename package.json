{
  "name": "rolld",
  "version": "0.0.0",
  "description": "rolld — an atproto-native board game tracker. Log plays, rate games; records live on each user's own PDS. No application database: reads come from the Constellation backlink index, metadata is hydrated from BoardGameGeek through a stateless Cloudflare Worker.",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "private": true,
  "homepage": "https://rolld.at",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy --branch=trunk",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p worker/tsconfig.json --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:lexicons": "tsx scripts/lexicon-validate.ts",
    "check:lexicons": "bash scripts/check-lexicons.sh",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260630.1",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "happy-dom": "^20.10.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.3",
    "@atcute/bluesky": "^4.0.12",
    "@atcute/client": "^5.1.1",
    "@atcute/identity-resolver": "^2.0.1",
    "@atcute/oauth-browser-client": "^4.0.1",
    "fast-xml-parser": "^5.9.3"
  }
}
